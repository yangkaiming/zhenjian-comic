# 开发/测试环境配置模板。复制为 .env 后按需修改：
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
#
# 注意：.env 与 .env.prod 都在 .gitignore 中，不会被提交到仓库。
# 线上打包用的连接串放在 .env.prod（见 README 2.3），同样不提交。

# 数据环境：test = 走本地测试库；prod = 走 .env.prod 的线上库
COMIC_DATA_ENV=test

# 本地服务端口（前端 dev server 端口在 web/vite.config.ts）
PORT=9527

# 本地/远程 MongoDB 连接串
MONGODB_URI=mongodb://127.0.0.1:27017/zhenjian-comic

# JWT 签名密钥（生产环境务必换成随机长字符串）
JWT_SECRET=zhenjian-comic-dev-secret
